# Copy to .env and fill in. Never commit .env.

# --- LLM (OpenRouter) ---------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-...

# Model per agent (format: openrouter/<provider>/<model>). Must support structured output + tools.
PM_MODEL=openrouter/<provider>/<model>
ARCHITECT_MODEL=openrouter/<provider>/<model>
BACKEND_MODEL=openrouter/<provider>/<model>
FRONTEND_MODEL=openrouter/<provider>/<model>
TESTER_MODEL=openrouter/<provider>/<model>

# --- Run limits ---------------------------------------------------------------------------------
# Over this, the run stops with status failed: budget and keeps its artifacts.
BUDGET_USD=1.00
# Optional token cap (used when cost is not available). Empty = no token cap.
BUDGET_TOKENS=
MAX_FIX_ROUNDS=3
# Architect retries when the Contract fails validation.
MAX_CONTRACT_RETRIES=3

# --- Sandbox (Docker) ---------------------------------------------------------------------------
SANDBOX_IMAGE=codeit-sandbox-base
SANDBOX_MEMORY=512m
SANDBOX_CPUS=1.0
SANDBOX_PIDS_LIMIT=256
SANDBOX_CHECK_TIMEOUT_S=180
PREVIEW_TTL_MINUTES=30
PREVIEW_PORT_RANGE=9000-9099

# --- Paths --------------------------------------------------------------------------------------
WORKSPACE_DIR=workspace
OUTPUT_DIR=output
